# CanchaPro - Environment Variables Template
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# MERCADO PAGO
# =============================================================================
NEXT_PUBLIC_MP_CLIENT_ID=your-mp-client-id
NEXT_PUBLIC_MP_CLIENT_SECRET=your-mp-client-secret
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# =============================================================================
# GMAIL (Email)
# =============================================================================
# Usá tu email de Gmail y una App Password (no tu contraseña real)
# Para crear App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=tuemail@gmail.com
GMAIL_APP_PASSWORD=tu-app-password-de-16-caracteres
GMAIL_FROM=noreply@canchapro.app

# =============================================================================
# UPSTASH (Redis)
# =============================================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# =============================================================================
# POSTHOG
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# SENTRY (Error Tracking)
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_AUTH_TOKEN=your-auth-token

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CanchaPro